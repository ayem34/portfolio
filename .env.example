# Copier ce fichier en .env pour changer les valeurs par défaut.
# Ne jamais mettre de vraie clé dans le dépôt : .env est ignoré par Git.

# --- Compte administrateur (créé au premier démarrage si aucun compte n'existe) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changez-moi

# --- Sécurité ---
# Clé de signature des sessions. En production : une longue valeur aléatoire
# (par exemple : python -c "import secrets; print(secrets.token_urlsafe(48))").
SECRET_KEY=cle-locale-a-changer-en-production
# development | production (production : documentation de l'API désactivée)
ENVIRONMENT=development
# true en production (cookie envoyé uniquement en HTTPS)
COOKIE_SECURE=false
# Adresses autorisées à appeler l'API depuis un navigateur (CORS), séparées par des virgules
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080
# Durée de la session admin, en minutes
JWT_EXPIRE_MINUTES=60
# Nombre de serveurs relais de confiance devant l'API (0 en local, 1 sur Render).
# Sert à retrouver l'adresse du visiteur pour la limitation de requêtes.
TRUSTED_PROXY_COUNT=0

# --- Base de données ---
# En local, docker compose fournit PostgreSQL. En ligne : chaîne de connexion Supabase.
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@db:5432/portfolio

# --- Fichiers : local (dossier uploads/) ou supabase ---
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=portfolio

# --- E-mails : smtp (Mailpit en local), resend (en ligne) ou console (affichage dans les journaux) ---
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
RESEND_API_KEY=
EMAIL_FROM=Portfolio <portfolio@localhost>
# Adresse qui reçoit les notifications (par défaut : ADMIN_EMAIL)
NOTIFICATION_EMAIL=

# --- Publication ---
# En local : le service « site » régénère les pages. En ligne : URL du deploy hook Vercel.
DEPLOY_HOOK_URL=http://site:8080/__deploy
# Adresse publique du site (liens dans les e-mails, sitemap, aperçus de partage)
SITE_URL=http://localhost:8080

# --- Contenu d'exemple fictif, en brouillon, créé au premier démarrage ---
SEED_EXAMPLE_CONTENT=true
